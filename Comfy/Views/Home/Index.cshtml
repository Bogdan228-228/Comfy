@using Comfy.Helpers
@using DOMAIN
@model List<Product>
@{
    ViewData["Title"] = "Home Page";
    var cart = Context.Session.GetObjectFromJson<List<CartItem>>("Cart") ?? new List<CartItem>();
    var cartCount = cart.Sum(c => c.Quantity);
}

<div class="container">
    <div class="d-flex align-items-center mb-4">
        <h2 class="mb-0 text-center flex-grow-1">All Products</h2>

        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success position-relative ms-3">
            <i class="bi bi-cart"></i> Кошик
            @if (cartCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @cartCount
                </span>
            }
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <form asp-action="Index" method="get" class="input-group">
                <input type="text" name="searchString" value="@Context.Request.Query["searchString"]"
                       class="form-control" placeholder="Пошук товару за назвою..." />
                <button type="submit" class="btn btn-outline-success">Пошук</button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-2">
                @await Html.PartialAsync("_ProductCard", product)
            </div>
        }
    </div>
</div>
