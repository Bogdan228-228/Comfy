@model DOMAIN.Product
@{
    Layout = "_Layout";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Додати товар у каталог Comfy</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Назва техніки</label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Смартфон Apple iPhone 15" required />
                </div>
                
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Ціна (₴)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                </div>

                <div class="d-flex justify-content-between pt-3">
                    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
                    <button type="submit" class="btn btn-success" style="background-color: #43b02a; border: none;">Зберегти товар</button>
                </div>
            </form>
        </div>
    </div>
</div>