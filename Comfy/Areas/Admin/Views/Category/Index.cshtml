@model IEnumerable<DOMAIN.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #43b02a; font-weight: bold;">Панель керування Comfy</h2>
        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-success" style="background-color: #43b02a; border: none;">+ Додати нову категорію</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Назва категорії</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Категорій поки немає. Додайте першу!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td class="font-weight-bold">@item.Name</td>
                                <td>
                                    <form asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Ви впевнені?')">Видалити</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>