@model IEnumerable<DOMAIN.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="color: #43b02a; font-weight: bold;">Панель керування Comfy</h2>

        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
               class="btn btn-success"
               style="background-color: #43b02a; border: none;">
                Доступні категорії
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create"
               class="btn btn-success"
               style="background-color: #43b02a; border: none;">
                + Додати новий товар
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Назва товару</th>
                        <th>Ціна</th>
                        <th>Кількість</th>
                        <th>Категорія</th>
                        <th>Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Товарів поки немає. Додайте перший!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>#@item.Id</td>
                                <td class="fw-bold">@item.Name</td>
                                <td><span class="badge bg-light text-dark fs-6">@item.Price ₴</span></td>
                                <td>@item.Quantity</td>
                                <td>@item.Category?.Name</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-info me-1">
                                        Деталі
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        Змінити
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       onclick="return confirm('Ви впевнені?')">
                                        Видалити
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
