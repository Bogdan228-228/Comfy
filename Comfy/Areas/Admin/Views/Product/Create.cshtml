@using Comfy.ViewModels
@model ProductViewModel

<div class="container mt-5" style="max-width: 700px;">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Додати товар у каталог Comfy</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label font-weight-bold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Наприклад: Смартфон Apple iPhone 15" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label font-weight-bold"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label font-weight-bold"></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label font-weight-bold"></label>
                    <input asp-for="Quantity" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label font-weight-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Короткий опис товару"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label font-weight-bold"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between pt-3">
                    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
                    <button type="submit" class="btn btn-success" style="background-color: #43b02a; border: none;">
                        Зберегти товар
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
